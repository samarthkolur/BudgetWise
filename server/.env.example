# Copy to server/.env and fill in. Never commit the filled-in file.

# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=budgetwise

# Signs our own session tokens. Minimum 32 characters; the server refuses to
# start below that. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# Every client ID that may appear in a Google ID token's `aud`. The web one is
# required; add the mobile ones or tokens minted by the phone are rejected.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

PORT=8080
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60
