# Copy to server/.env and fill in. Never commit the filled-in file.
#
# This is the Node/TypeScript/Prisma/PostgreSQL server (see server/src/).
# The sibling Dart files (server/lib, server/bin, server/pubspec.yaml) are the
# previous Mongo-backed implementation, kept only until a human verifies and
# removes them.

# Postgres connection string. `docker compose up -d` starts a local Postgres
# on 127.0.0.1:5432 with no authentication beyond this file's own password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budgetwise

# Signs our own session tokens (JWT, HS256). Minimum 32 characters; the
# server refuses to start below that. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

PORT=8080
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60
