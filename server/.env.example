# Copy to server/.env and fill in. Never commit the filled-in file.

# --- local, no cloud services ------------------------------------------------
# This is the default setup: `docker compose up -d` then `./scripts/run_local.sh`.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=budgetwise

# Signs our own session tokens. Minimum 32 characters; the server refuses to
# start below that. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# Sign in with no Google account at all.
#
# This is a REAL authentication bypass: anyone who can reach the endpoint
# becomes the named user with no credential. The server refuses to start with it
# enabled unless MONGO_URI points at a local database, so it cannot be turned on
# against a hosted cluster by accident. Leave it false for anything real.
ALLOW_DEV_LOGIN=true

# --- Google sign-in ----------------------------------------------------------
# Required only when ALLOW_DEV_LOGIN is false. Every client ID that may appear
# in an ID token's `aud`: the web one is the audience, and the mobile ones must
# be listed or tokens minted by a phone are rejected.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

PORT=8080
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60
